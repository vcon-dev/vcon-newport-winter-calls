{
  "vcon": "0.4.0",
  "uuid": "630368c5-4885-848c-bbac-c2c4fb26f20f",
  "created_at": "2025-12-04T10:30:13-05:00",
  "subject": "Inbound call, Recreation",
  "parties": [
    {
      "name": "Maureen T. Quinn",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Beth Almeida",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-04T10:28:33-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Recreation Department, this is Beth, good morning!"
    },
    {
      "type": "text",
      "start": "2025-12-04T10:28:36-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good morning, Beth. This is Maureen Quinn. I'm calling about the senior center, I'd like to get the program schedule for the winter if there is one."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:28:45-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sure thing. We have a winter schedule with classes, lunches, exercise, card games, that kind of thing. Is this for you?"
    },
    {
      "type": "text",
      "start": "2025-12-04T10:28:52-05:00",
      "duration": 11,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It's for my mother, actually. She's home with me. She reads the newspaper aloud every morning at the table, the whole thing, and I think she'd like to be around more people to talk about it with."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:03-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, that's a good reason. A lot of folks come in just to chat over coffee."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:08-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good. Now, is there an age limit? I'm not sure if she has to be a certain age to join."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:15-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Generally the senior center programs are meant for older adults, sixty and up is the usual cutoff. Is your mother past that?"
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:22-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, yes, well past. And what about me, if I come along to drive her? I'm not that age."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:28-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Family members and drivers are welcome to come in with her. Some activities might be limited to members, but you can sit in the lobby or ask the front desk when you get there."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:38-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right. Can you mail the schedule or should I pick it up?"
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:43-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Either works. I can mail it today, or you can pick one up at the front desk. It's usually also posted online on the city site."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:51-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Mail it, please. I'll give you the address."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:54-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Go ahead, I'm ready."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:29:56-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Actually, hold on, I told them not to give an address. Let me just come get one this afternoon."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:30:02-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem at all. Front desk is open all day, they'll have copies right there."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:30:07-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you, Beth. That's all I needed."
    },
    {
      "type": "text",
      "start": "2025-12-04T10:30:10-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You're welcome, have a great day!"
    }
  ],
