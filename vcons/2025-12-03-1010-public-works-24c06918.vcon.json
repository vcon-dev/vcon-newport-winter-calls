{
  "vcon": "0.4.0",
  "uuid": "24c06918-e016-89c5-8858-cf53258cd4ac",
  "created_at": "2025-12-03T10:11:43-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Siobhan Flynn",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Kevin Sousa",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-03T10:10:43-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Kevin. How can I help you?"
    },
    {
      "type": "text",
      "start": "2025-12-03T10:10:46-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good morning, Kevin. I am calling about a pothole in the road. It is very deep, a tire could go right in. Meu Deus, I am afraid for the cars."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:10:54-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, a deep one. Where's it at?"
    },
    {
      "type": "text",
      "start": "2025-12-03T10:10:57-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "In front of 323 Narragansett Avenue. That is in the Fifth Ward. It is by the edge of the road, near the curb."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:03-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, 323 Narragansett Avenue, deep pothole near the curb. Anything else I should note?"
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:07-05:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I have photos, taken with my telephone. If you want them, I can send. Wait, one moment, I also must remember a gift card I want to use today. It is in my purse. Sorry, that is not for you."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:17-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No worries. Yes, photos help. I'll note that you have them, and someone can follow up on how to send them."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:23-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you. Could I have a reference number for this report, please?"
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:27-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sure, let me get it entered. [pause] Okay, I'll read it to you slowly. Do you have a pen?"
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:32-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, I have a pen. Go ahead, please."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:35-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It's PW, then 4 4 1 7. Crews will look at it."
    },
    {
      "type": "text",
      "start": "2025-12-03T10:11:39-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "PW 4417. Thank you very much, Kevin. Have a good day."
    }
  ],
