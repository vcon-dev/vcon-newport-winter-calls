{
  "vcon": "0.4.0",
  "uuid": "f5f39cd7-884e-8861-954b-afd3e3ab6658",
  "created_at": "2026-03-05T12:52:32-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Holly Chase",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Sandra Pimentel",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-03-05T12:51:32-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Sandra. Good afternoon, how can I help you?"
    },
    {
      "type": "text",
      "start": "2026-03-05T12:51:37-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi, great! Hi there. I'm trying to reach the Registry of Motor Vehicles. I need to renew my license. Is this the right place?"
    },
    {
      "type": "text",
      "start": "2026-03-05T12:51:45-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, honey, no, this is the City Clerk at Newport City Hall. The Registry is a state office, so you'd want to look up the state's number or go through their website."
    },
    {
      "type": "text",
      "start": "2026-03-05T12:51:55-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, wonderful, so I dialed the wrong one! Ha! I must be working off some ancient list. I think I wrote that number down about ten years ago."
    },
    {
      "type": "text",
      "start": "2026-03-05T12:52:04-05:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "[pause] Happens all the time. Those lists get stale. A quick search for Rhode Island Registry of Motor Vehicles should bring up the right number and their online services."
    },
    {
      "type": "text",
      "start": "2026-03-05T12:52:13-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Great, I'll do that. Oh, sorry, hang on, somebody just rang the doorbell. It's a delivery driver, I'm just going to ignore it. They'll leave it on the step."
    },
    {
      "type": "text",
      "start": "2026-03-05T12:52:22-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sounds good to me. Anything else I can do for you today?"
    },
    {
      "type": "text",
      "start": "2026-03-05T12:52:26-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Nope, that's it! Thank you so much, Sandra. Wonderful. Have a good one!"
    },
    {
      "type": "text",
      "start": "2026-03-05T12:52:30-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too, take care now."
    }
  ],
