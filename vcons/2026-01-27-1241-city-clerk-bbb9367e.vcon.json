{
  "vcon": "0.4.0",
  "uuid": "bbb9367e-8bdb-811f-b148-d3dc5f7ca0e3",
  "created_at": "2026-01-27T12:43:09-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "David Thurston",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-01-27T12:41:32-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa Delgado. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-01-27T12:41:37-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh. Hi there. [pause] Is this... the pizza place? On Thames?"
    },
    {
      "type": "text",
      "start": "2026-01-27T12:41:42-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, I'm sorry, this is the Newport City Clerk at City Hall. Who were you trying to reach?"
    },
    {
      "type": "text",
      "start": "2026-01-27T12:41:49-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Ha. Well. [pause] I wanted to order lunch. I must've dialed it wrong. Sorry about that."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:41:56-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem at all, it happens. Do you have the restaurant's number written down?"
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:02-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I do. Um. [pause] It's on my fridge magnet. But I think I put in the wrong area code. Is it not four-oh-one?"
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:11-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Four-oh-one is the right one for Newport and all of Rhode Island. So the area code's probably fine. It may be one of the other digits that got switched."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:22-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh. Okay. [pause] I thought maybe it changed. My phone is new. Well, newish."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:28-05:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Nope, still four-oh-one. If you can't find the right number, you could look the restaurant up online, or check the magnet again slowly."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:37-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good idea. [pause] Sorry, you might hear a noise. I'm sharpening pencils. The grinder is on."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:44-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I can hear it, a little whirring. No worries. Sounds like you're busy."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:50-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Just a lot of pencils. [pause] Ha. Well. Thank you for being so nice about it."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:42:57-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Of course. Enjoy your lunch, Mr.... sorry, I didn't catch your name."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:43:02-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "David. David Thurston. [pause] You have a good day."
    },
    {
      "type": "text",
      "start": "2026-01-27T12:43:06-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too, David. Take care."
    }
  ],
