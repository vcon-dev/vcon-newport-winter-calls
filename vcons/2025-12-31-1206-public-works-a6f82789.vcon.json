{
  "vcon": "0.4.0",
  "uuid": "a6f82789-5793-80dc-89f6-0108d0946b0b",
  "created_at": "2025-12-31T12:07:32-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Fernando Correia",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Denise Arruda",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-31T12:06:32-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Denise."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:06:34-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. This is Fernando Correia. My recycling bin is gone. They picked up this morning and now the bin is not there."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:06:41-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, I'm sorry about that. Where are you located, Mr. Correia?"
    },
    {
      "type": "text",
      "start": "2025-12-31T12:06:45-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "343 Bliss Road. Down toward Easton's Beach. I put it at the curb last night. The blue one. This morning the truck came. After that, no bin."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:06:53-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it. Sometimes they get tossed into a neighbor's yard or down the street. Did you look around?"
    },
    {
      "type": "text",
      "start": "2025-12-31T12:06:59-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I looked. Both sides of the road. It is not there."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:03-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right. I'll put in a report for a replacement. Do you want someone to call you about it?"
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:09-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. I want a supervisor to call me back. The number is 401-555-0169."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:14-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "401-555-0169, I have it. I'll pass that along today."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:18-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good. I am home. I am writing out my holiday card list by hand, so I will be at the table."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:25-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sounds like a nice way to spend the day. Happy New Year, Mr. Correia."
    },
    {
      "type": "text",
      "start": "2025-12-31T12:07:30-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you. Goodbye."
    }
  ],
