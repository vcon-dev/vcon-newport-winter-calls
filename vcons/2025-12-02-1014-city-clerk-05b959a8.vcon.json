{
  "vcon": "0.4.0",
  "uuid": "05b959a8-2c8c-8852-b561-287fce09bc83",
  "created_at": "2025-12-02T10:15:17-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Adriana Valdez",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Sandra Pimentel",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-02T10:14:16-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Sandra, good morning."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:14:19-05:00",
      "duration": 11,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi, good morning. Okay, this is embarrassing. I think I dialed the wrong number. I was trying to get a restaurant and I think my thumb has a mind of its own."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:14:30-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That happens more than you'd think. Which restaurant were you after?"
    },
    {
      "type": "text",
      "start": "2025-12-02T10:14:34-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It's a takeout place, I was going to order lunch. I'm so sorry, I didn't mean to bother you."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:14:41-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No bother at all. I can't look up restaurants from here, but if you search the name on your phone, the number should come right up. Or check the little map listing."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:14:52-05:00",
      "duration": 13,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yeah, that's the smart move. I was going off a number I had scribbled on the back of a school lunch menu. Those come home in a folded sheet and I never read them, so honestly that's on me."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:15:05-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, at least it's good for something. Hope you find your lunch."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:15:10-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thanks. Sorry again for the trouble. Have a good day."
    },
    {
      "type": "text",
      "start": "2025-12-02T10:15:14-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too, hon. Bye now."
    }
  ],
