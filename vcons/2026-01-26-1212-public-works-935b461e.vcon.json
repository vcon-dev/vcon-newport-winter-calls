  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Helena Teixeira",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Denise Arruda",
      "role": "clerk",
      "validation": "synthetic"
