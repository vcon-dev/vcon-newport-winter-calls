{
  "vcon": "0.4.0",
  "uuid": "4b27bf86-df6e-8571-857b-ebab72368205",
  "created_at": "2026-02-20T13:41:10-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Marisa Semedo",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-02-20T13:40:10-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa. Buenas tardes, how can I help you?"
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:15-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi. Is this the library?"
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:17-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, this is the City Clerk at City Hall. Were you trying to reach the Newport library?"
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:23-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yeah. Sorry."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:25-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem at all. What number did you dial, do you remember?"
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:29-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It was four-oh-one. Is that not Newport?"
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:32-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Four-oh-one is right, that's all of Rhode Island. So the area code was fine. It's probably one of the digits after that."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:39-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh. Okay. I thought it was different. For the town."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:43-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Nope, same area code statewide. Now, were you looking for the Records office? Because that's a different thing from the library."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:50-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No. Library. Like, books."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:40:52-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, books. You want the Newport Public Library, not the clerk's records. I'd look it up online or search the library's name in your phone, that's the quickest way to get the right number."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:41:03-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Will do."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:41:05-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Perfect. Have a nice afternoon, and enjoy the reading."
    },
    {
      "type": "text",
      "start": "2026-02-20T13:41:08-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thanks. You too. Bye."
    }
  ],
