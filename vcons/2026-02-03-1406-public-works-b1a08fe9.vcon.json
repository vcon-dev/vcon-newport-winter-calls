  "dialog": [
    {
      "type": "text",
      "start": "2026-02-03T14:06:39-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Denise."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:06:42-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good afternoon. My name is Carlos Correia. I am calling about trash that was not collected, at 204 Kingston Avenue, up on the Hill."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:06:51-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, what was left behind?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:06:53-05:00",
      "duration": 15,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "My landlord put out bulk waste on the curb after a tenant moved out. A mattress, a chair, some boxes. The truck did not take it. On the other hand, my regular bags were taken. This is the second miss in a row, you understand."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:07:08-05:00",
      "duration": 12,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it. Bulk items sometimes need to be set up ahead of time, so I'll put in a request to have a crew look at it. Is there a number if they need you?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:07:20-05:00",
      "duration": 12,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, 401-555-0160. But please, I am a line cook on a split schedule today. I leave at four and come back late. On the other hand, the landlord may be reachable in the day."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:07:32-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem, I'll note that. Someone will follow up."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:07:36-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you very much. Good day."
    }
  ],
