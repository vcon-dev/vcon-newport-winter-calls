  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Maureen Lynch",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Sandra Pimentel",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-04T13:11:20-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Sandra, good afternoon."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:24-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi. Is this the state tax division?"
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:28-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, no, hon, this is the City Clerk's office here in Newport. Were you trying to reach the state?"
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:36-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. Sorry. Wrong number."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:38-05:00",
      "duration": 15,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's all right, it happens all the time. The state tax division is the Rhode Island Division of Taxation, so that's a state office, not the city. If you search that name online, their main number comes right up."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:53-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Division of Taxation. Okay."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:11:55-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's the one. They're in Providence, and they can help with whatever you're calling about."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:12:02-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Thanks for picking up so quick."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:12:06-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, you're welcome. Hope you get it sorted out."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:12:10-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sorry again for the bother."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:12:13-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No bother at all. You have a good afternoon now."
    },
    {
      "type": "text",
      "start": "2025-12-04T13:12:18-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too. Bye."
    }
  ],
