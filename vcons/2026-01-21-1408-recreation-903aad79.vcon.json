{
  "vcon": "0.4.0",
  "uuid": "903aad79-0020-8c4a-b8a5-73435c8cfb31",
  "created_at": "2026-01-21T14:10:04-05:00",
  "subject": "Inbound call, Recreation",
  "parties": [
    {
      "name": "Liam B. Dolan",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Beth Almeida",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-01-21T14:08:25-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Recreation Department, this is Beth, how can I help you this afternoon?"
    },
    {
      "type": "text",
      "start": "2026-01-21T14:08:29-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good afternoon, Beth. Thank you very much for taking my call. I hope you are having a good Wednesday and that the day is treating you well."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:08:38-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, thank you, I am! It's been a nice quiet one so far. What can I do for you?"
    },
    {
      "type": "text",
      "start": "2026-01-21T14:08:44-05:00",
      "duration": 12,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Very kind of you. So, my name is Liam Dolan, and I am a homeowner here in Newport. I am calling because I would like to ask about the winter program for the youth basketball. Is the sign-up open now?"
    },
    {
      "type": "text",
      "start": "2026-01-21T14:08:56-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It sure is. We're taking registrations for winter youth basketball right now. You can come in and fill out a form, or we can start it over the phone if you'd like."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:06-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, good. Thank you. And may I ask, please, when is the start date? When do the games or the practices begin?"
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:13-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Let me pull that up. [pause] Okay, so the season kicks off with practices the first week of February, and the schedule goes out to families once teams are set."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:23-05:00",
      "duration": 14,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "First week of February. Yes, that is clear. Thank you. Then I will come to the office to sign up. Is it the same counter where the kindergarten registration packet is? I saw that the packet is on the counter when I passed last week."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:37-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yep, same front counter. The kindergarten packets are right there, and the basketball forms are just next to them. Just ask whoever's at the desk."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:45-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Perfect. That is very helpful. I will come this week, God willing."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:49-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sounds great. Do you want me to jot down your number in case we have questions about the form?"
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:55-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, of course. It is 401-555-0168."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:09:58-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, 401-555-0168. Thanks for calling, Mr. Dolan."
    },
    {
      "type": "text",
      "start": "2026-01-21T14:10:01-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you, Beth. Have a blessed afternoon. Goodbye."
    }
  ],
