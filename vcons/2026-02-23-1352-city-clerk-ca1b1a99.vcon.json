      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-02-23T13:52:28-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Sandra, good afternoon."
    },
    {
      "type": "text",
      "start": "2026-02-23T13:52:31-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh. Yes, hello. I'm trying to reach the fire department. The non-emergency line, not 911. I have the number written down here on my note."
    },
    {
      "type": "text",
      "start": "2026-02-23T13:52:39-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, you've reached the City Clerk at City Hall, hon. Fire is a different office. What number did you dial?"
    },
    {
      "type": "text",
      "start": "2026-02-23T13:52:46-05:00",
      "duration": 11,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Let me read it. It says area code four-oh-one, and then the number. But my phone put up a different area code on the screen, and I don't understand why. Is that a problem?"
    },
    {
      "type": "text",
      "start": "2026-02-23T13:52:57-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Four-oh-one is us, that's all of Rhode Island. Sounds like a digit got turned around somewhere. Is this a cell phone?"
    },
    {
      "type": "text",
      "start": "2026-02-23T13:53:04-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, it's my landline. But, um, the other phone keeps switching to some weaker network, so I thought maybe that did it. I'm not sure what I pressed."
    },
    {
      "type": "text",
      "start": "2026-02-23T13:53:13-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Could be, those do act up. Tell you what, I'll transfer you right over to the fire department's regular business line. Stay on with me."
    },
    {
      "type": "text",
      "start": "2026-02-23T13:53:21-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, that's kind. I wanted to ask about the smoke detector checks after last weekend's nor'easter, Saturday into Sunday. Thank you, dear."
    },
    {
      "type": "text",
      "start": "2026-02-23T13:53:28-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No trouble at all. Here you go, one moment."
    }
  ],
