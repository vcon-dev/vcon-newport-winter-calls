{
  "vcon": "0.4.0",
  "uuid": "5f3a78f1-c90f-80a6-8960-06b98e8785ab",
  "created_at": "2026-03-05T13:07:19-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Edson Rocha",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Owen Haskell",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-03-05T13:05:39-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Owen. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-03-05T13:05:43-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good afternoon. Please, I would like to ask about a birth certificate. I need a certified copy for my mother, for a passport."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:05:51-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Certified copy of a birth certificate. Was your mother born here in Newport?"
    },
    {
      "type": "text",
      "start": "2026-03-05T13:05:56-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, she was born in Newport. Excuse me, I am calling for her because she does not drive anymore. I am her son."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:04-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right. Let me go slowly so I get it right. For a certified copy, she or an immediate family member can request it, and you would need to show identification."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:14-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, thank you. Please, can you tell me about the fee? How much is it for one copy?"
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:20-05:00",
      "duration": 13,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I don't have the exact amount in front of me, and I don't want to read you the wrong number. The fee is posted on the city website under vital records, or I can have someone confirm it when you come in."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:33-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, I understand. Please, do I need to bring something special, besides my identification?"
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:38-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Bring your own photo ID, and it helps to have your mother's full name and her date of birth. If you can, bring something that shows you're her son. Her ID too, if she has it."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:49-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, perfect. Please excuse the noise. We have Sunday dinner every week, it is our family tradition, and the cooking has already started in the kitchen."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:06:57-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem at all, I can barely hear it. Sounds like a good start."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:07:02-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. Please, what are the hours for the office? I would like to come this week."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:07:08-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "We're open weekdays during regular business hours. Tomorrow, Friday, would work fine."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:07:12-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you very much. That is all I need. Have a good afternoon."
    },
    {
      "type": "text",
      "start": "2026-03-05T13:07:17-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too. Take care."
    }
  ],
