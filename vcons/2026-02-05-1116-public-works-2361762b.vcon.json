  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Nelson Costa",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Kevin Sousa",
      "role": "clerk",
      "validation": "synthetic"
