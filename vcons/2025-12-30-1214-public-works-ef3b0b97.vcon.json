{
  "vcon": "0.4.0",
  "uuid": "ef3b0b97-908d-8a42-a8ab-ed6577860e35",
  "created_at": "2025-12-30T12:15:39-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Bruce Tillinghast",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Denise Arruda",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-30T12:14:39-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Denise."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:14:42-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. [pause] Hello. This is Bruce Tillinghast. [pause] I'm at 105 Callender Avenue."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:14:47-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi Mr. Tillinghast. What's going on at Callender?"
    },
    {
      "type": "text",
      "start": "2025-12-30T12:14:50-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Puddle in the road. [pause] Goes halfway across. Won't drain."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:14:54-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Did you get rain recently?"
    },
    {
      "type": "text",
      "start": "2025-12-30T12:14:57-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No. [pause] Not since Monday. It's dry. [pause] Doesn't make sense."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:01-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Is it a storm drain, a grate nearby?"
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:04-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. I cleaned the leaves off. [pause] By hand. Helped for about ten minutes. [pause] Then it was back."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:11-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, so it's likely blocked underneath. I'll put in a request for a crew to look at it."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:18-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good. [pause] Do the crews work weekends? [pause] My grandson's baby is here. Nobody sleeps. Cars splash the window all night."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:25-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Congratulations. Crews can be out on weekends for urgent things, but I'd expect this one sooner, in the regular week. I have your address, and I'll note the number you're calling from."
    },
    {
      "type": "text",
      "start": "2025-12-30T12:15:36-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you. [pause] That's all."
    }
  ],
