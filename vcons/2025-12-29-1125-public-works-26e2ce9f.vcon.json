{
  "vcon": "0.4.0",
  "uuid": "26e2ce9f-2896-8d77-a37c-afd403719af6",
  "created_at": "2025-12-29T11:27:06-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Paula Vieira",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Lorraine Medeiros",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-29T11:25:44-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Lorraine. How can I help you?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:25:48-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hello, yes. I want to report a streetlight. The light, it stays on all day long. Even now, at almost noon, it is shining."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:25:57-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, a streetlight that's on during the day. Can you tell me where it is?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:03-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It is in front of my building, 122 Dean Avenue. The pole by the sidewalk, na frente da casa, sorry. In front of the house."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:12-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No need to apologize at all. So that's 122 Dean Avenue, the pole right out front. Has it been on around the clock?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:20-05:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, day and night. I noticed it a few days ago, and it does not turn off. I would like a crew to come and check the pole, please."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:30-05:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I'll put in a request for a crew to look at that pole. Would you like to leave a callback number, in case they have questions?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:39-05:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. It is 401-555-0161. Oh, wait, excuse me, my tablet is updating again. It does this at the worst moments. Every time, it updates by itself. Desculpe."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:49-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's all right, take your time. Let me read it back: 401-555-0161, Paula Vieira, 122 Dean Avenue, streetlight on all day."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:26:57-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, that is correct. Thank you very much."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:27:01-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You're welcome. Have a good afternoon."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:27:04-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too. Goodbye."
    }
  ],
