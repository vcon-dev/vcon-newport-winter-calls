{
  "vcon": "0.4.0",
  "uuid": "761c8655-45e2-81a4-9508-a459c1ddb49f",
  "created_at": "2026-03-06T10:58:34-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Margaret Chase",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-03-06T10:57:21-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-03-06T10:57:25-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, hello. I'm looking for Newport Taxi. Is this the cab company?"
    },
    {
      "type": "text",
      "start": "2026-03-06T10:57:30-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, ma'am, this is the City Clerk at City Hall. I think you've got the wrong number."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:57:36-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, I'll be. I'm reading off an old list I keep by the phone. It's older than some of your staff, I'd guess."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:57:44-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That happens a lot. I don't have a number for the taxi companies in front of me, but a directory or an online search should have a current one for you."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:57:55-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I'll have my granddaughter look it up. And it's Newport Taxi, not Newport Cab, if you're going to be precise about it."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:58:03-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Understood, Newport Taxi. Sorry I can't connect you."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:58:07-05:00",
      "duration": 12,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No need to apologize. I just need a ride this afternoon. The school is having a book fair and they want twenty dollars from me for it, so I have to get over there before it ends."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:58:19-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. With the rain coming in today, I'd call them soon, because rides fill up fast in weather like this."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:58:26-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, I saw the rain is hitting today. Thank you, dear. Goodbye now."
    },
    {
      "type": "text",
      "start": "2026-03-06T10:58:31-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You're welcome, ma'am. Take care, goodbye."
    }
  ],
