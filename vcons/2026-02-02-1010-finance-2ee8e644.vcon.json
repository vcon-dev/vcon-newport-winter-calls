  "subject": "Inbound call, Finance",
  "parties": [
    {
      "name": "Cristina Medeiros",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Luis Barros",
      "role": "clerk",
      "validation": "synthetic"
