{
  "vcon": "0.4.0",
  "uuid": "a4190e85-a32d-8e8e-8386-348d766240e7",
  "created_at": "2025-12-18T10:59:20-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Anthony Ricci",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-18T10:58:17-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa. How can I help you?"
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:21-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yeah, hi. I'm looking for a cab company. I think I got the wrong number."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:27-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, you did reach City Hall, the clerk's office. We don't do taxis here."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:32-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Figured. I had an old list in my wallet. Looks like the numbers got shuffled. Or I did. [pause]"
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:39-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It happens. Your best bet is to look up a local taxi company online or check the phone book. Do you have someone who can look it up for you?"
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:49-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I'll do it on my phone. I'm at the farmers market. The winter tables are small this time of year. [line breaks up] Signal's not great in here."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:58:58-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I only caught part of that. Did you say you'll look it up on your phone?"
    },
    {
      "type": "text",
      "start": "2025-12-18T10:59:04-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. I'll look it up. It's for my mother. She needs a ride home after this rain."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:59:10-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, that's a wet one today. I hope you find someone quickly."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:59:15-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thanks. Sorry for the bother."
    },
    {
      "type": "text",
      "start": "2025-12-18T10:59:17-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No bother at all. Take care."
    }
  ],
