{
  "vcon": "0.4.0",
  "uuid": "5d451507-b459-870e-a4cc-1e3e287c2b01",
  "created_at": "2025-12-07T11:13:46-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Kevin Kearney",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Denise Arruda",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-07T11:12:27-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works storm line, this is Denise."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:30-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hello, good morning. Yes, I know City Hall is closed on Sunday, so I call the storm line. I hope this is okay."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:39-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's exactly what it's for. What's going on?"
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:43-05:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "The storm drain in front of my house, it is gurgling. And a smell comes up from it, like sewer. This is after the nor'easter that ended yesterday."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:53-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. What's the address?"
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:55-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Two thirty-nine Eustis Avenue. Kevin Kearney. K-E-A-R-N-E-Y."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:12:58-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, Mr. Kearney. Is water backing up into the street, or just the noise and smell?"
    },
    {
      "type": "text",
      "start": "2025-12-07T11:13:05-05:00",
      "duration": 13,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Just noise and smell now, but I am worried it will come up. Before, I called, and someone told me this is a state road. So, I don't know. Is it a city drain or a state one?"
    },
    {
      "type": "text",
      "start": "2025-12-07T11:13:18-05:00",
      "duration": 12,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Honestly I can't say from here which it is. I'll put in a report with the address and have a crew check it, and if it's the state's, we'll pass it along to them."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:13:30-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, thank you. Sorry, my head is not so clear today. It is our anniversary this weekend, and I am distracted."
    },
    {
      "type": "text",
      "start": "2025-12-07T11:13:38-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, happy anniversary. Is 401-555-0179 the best number?"
    },
    {
      "type": "text",
      "start": "2025-12-07T11:13:42-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, that is correct. Thank you very much."
    }
  ],
