{
  "vcon": "0.4.0",
  "uuid": "71511bad-3ded-8ef5-be9c-8d1ad6075f76",
  "created_at": "2026-02-03T14:34:54-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Omar Abdi",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Kevin Sousa",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-02-03T14:33:49-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Kevin."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:33:51-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi, sorry, I know this is probably a small thing. I hit a pothole and I want to report it. You're actually my first call of the day."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:00-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem, that's what we're here for. Where's the pothole?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:04-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sorry, it's right in front of 298 Rhode Island Avenue, up on the Hill. It's near the curb on my side."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:11-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, 298 Rhode Island Avenue, pothole by the curb. Got it. Any damage?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:16-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yeah, sorry, the tire blew out and the rim is bent. [pause] I know it's silly to ask, but does the city reimburse for car damage?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:24-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Not silly at all. I can't tell you how that goes from here, but I can take your info and have someone call you about a claim. Is this a good number, 401-555-0179?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:34-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, that's it. Sorry, one more thing. How long do repairs usually take?"
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:39-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Depends on the weather and how many are ahead of it, but typically a few days to a couple of weeks this time of year. I'll put it in today."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:49-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, thank you. Sorry for the bother."
    },
    {
      "type": "text",
      "start": "2026-02-03T14:34:52-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No bother. Take care."
    }
  ],
