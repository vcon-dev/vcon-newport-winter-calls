{
  "vcon": "0.4.0",
  "uuid": "d4047205-2286-8018-b63b-10c869266a96",
  "created_at": "2026-02-20T14:06:54-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Nilson Tavares",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Sandra Pimentel",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-02-20T14:05:54-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Sandra. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-02-20T14:05:58-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi, sorry, I know this is silly, but is this the post office? I was trying to reach the post office."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:05-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, no, hon, this is the City Clerk at City Hall. You're not too far off, though. Lots of people mix us up."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:12-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sorry about that. I think I dialed off an old list I had. Honestly, it's probably from about ten years ago, so that's on me."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:20-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Happens all the time. Numbers move around. You'll want to look up the post office directly, they have their own listing online, or you can call information. I don't have their counter line in front of me."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:31-05:00",
      "duration": 11,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, that works. Sorry, I'm just trying to get a package sorted out before the weekend. The kids are all at their father's this week, so it's the one chance I've got to run errands."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:42-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, then you'd better get going. It's early enough on a Friday afternoon that you should catch them."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:48-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Right. Sorry for bothering you. Thanks for your help."
    },
    {
      "type": "text",
      "start": "2026-02-20T14:06:51-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No bother at all. Have a good weekend."
    }
  ],
