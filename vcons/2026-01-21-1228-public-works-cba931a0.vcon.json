{
  "vcon": "0.4.0",
  "uuid": "cba931a0-c6e7-8859-88f5-c25ae5181319",
  "created_at": "2026-01-21T12:30:11-05:00",
  "subject": "Inbound call, Public Works",
  "parties": [
    {
      "name": "Rocco Santoro",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Lorraine Medeiros",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-01-21T12:28:51-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Lorraine. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:28:56-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, my trash wasn't picked up on my usual day. That was this morning."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:02-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, I'm sorry about that. Can I get the address where the pickup was missed?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:09-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "20 Harrison Avenue, over on the Fort Adams side."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:13-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "20 Harrison Avenue, Fort Adams side. And the barrel was out at the curb this morning?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:20-05:00",
      "duration": 12,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It was out last night. Still sitting there full. [pause] Hold on one second. Sorry, I'm wrapping some gifts and this tape squeals every time it comes off the roll."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:32-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, no problem at all. Take your time."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:36-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Is there a fee for a make-up pickup?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:40-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, you shouldn't be charged for a missed pickup. I'll put in a report for 20 Harrison Avenue, and the crew will be notified to come back around. Leave the barrel where it is."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:54-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right. Will somebody call me?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:29:57-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I can note a callback number if you like. Is it 401-555-0190?"
    },
    {
      "type": "text",
      "start": "2026-01-21T12:30:03-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's the one."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:30:05-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, 401-555-0190. You're all set, Mr. Santoro."
    },
    {
      "type": "text",
      "start": "2026-01-21T12:30:09-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you. Goodbye."
    }
  ],
