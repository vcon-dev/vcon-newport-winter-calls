{
  "vcon": "0.4.0",
  "uuid": "7a88a936-97cd-8577-9913-4a9749a474fb",
  "created_at": "2026-03-12T13:30:54-04:00",
  "subject": "Inbound call, Finance",
  "parties": [
    {
      "name": "Yesenia Herrera",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Janet Whitcomb",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-03-12T13:29:18-04:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City of Newport Finance, this is Janet Whitcomb. How may I help you?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:29:23-04:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hello. I received a parking ticket yesterday for an expired registration sticker. But I renewed the registration the day before. I have the receipt."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:29:32-04:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I see. Do you have the ticket number in front of you?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:29:37-04:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes. [line breaks up] ...can you hear me? I said the ticket was written Wednesday. The sticker had not arrived yet in the mail."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:29:46-04:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I can hear you now. You'll need to submit proof of the renewal date for review. Is this your first ticket?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:29:54-04:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, the first one. So I am asking, can a first-time fine be waived? I would like a precise answer, please."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:02-04:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I can't promise a waiver on the phone. The review looks at your proof of renewal. I can send you the instructions by mail. What is your zip code?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:12-04:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It is 02840."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:14-04:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Reading back, 02804?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:16-04:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No. [inaudible] Wait. You said zero two eight zero four. Mine is zero two eight four zero."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:22-04:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you, 02840. Corrected."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:24-04:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good. Another question. I want to pay before the weekend if the review does not help. The office closes at five, yes? How do I pay when it is closed?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:34-04:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "There is a payment drop box at City Hall, and you can also pay online through the city website. Both are available outside our regular hours."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:43-04:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Online is available tonight, also Saturday?"
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:46-04:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, any time."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:48-04:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Thank you. That is all."
    },
    {
      "type": "text",
      "start": "2026-03-12T13:30:51-04:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You're welcome. Have a good afternoon."
    }
  ],
