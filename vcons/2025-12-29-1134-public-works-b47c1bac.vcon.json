      "validation": "synthetic"
    },
    {
      "name": "Kevin Sousa",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-29T11:34:43-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Kevin."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:34:46-05:00",
      "duration": 15,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hello, Kevin, yes, this is Josephine Fiore. I'm calling from my friend's car, she's driving me to my appointment, so if I sound like I'm bouncing around, that's why. She takes the Memorial Boulevard way, which I told her is slower, but anyway."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:01-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem, I can hear you fine. What can I help you with?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:06-05:00",
      "duration": 18,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "My trash. And the recycling, I think it's the recycling. They didn't take it. That's the second time in a row now, last time and this time. I put the bin out Friday night like always, because my sister used to say never wait for the morning, and it's still sitting there."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:24-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, second miss in a row. What's the address?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:28-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "96 Dean Avenue. Fifth Ward."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:31-05:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, 96 Dean Avenue. I'll write that up as a missed pickup, two in a row, so the crew supervisor sees it."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:40-05:00",
      "duration": 14,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you. And while I have you, I'm not sure what goes in the recycling anymore. Somebody told me they changed it. Pizza boxes, can those go? And glass? And those plastic clamshell things the strawberries come in?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:35:54-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Clamshells are usually fine if they're clean and empty. Glass jars and bottles go in too. Pizza boxes, the clean part of the cardboard is okay, but if it's greasy, tear that off and toss it in the trash."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:36:08-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Clean cardboard yes, greasy no, clamshells yes, glass yes. Okay. Now, did you want my phone number?"
    },
    {
      "type": "text",
      "start": "2025-12-29T11:36:15-05:00",
      "duration": 2,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sure, go ahead."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:36:17-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "401-555-0195."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:36:18-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "401-555-0195, got it. Someone will follow up on the pickup."
    },
    {
      "type": "text",
      "start": "2025-12-29T11:36:22-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thank you, Kevin. Goodbye."
    }
  ],
