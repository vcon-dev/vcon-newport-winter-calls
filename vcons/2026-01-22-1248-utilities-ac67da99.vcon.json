{
  "vcon": "0.4.0",
  "uuid": "ac67da99-f079-8983-9ae0-077e69bb0103",
  "created_at": "2026-01-22T12:54:41-05:00",
  "subject": "Inbound call, Utilities",
  "parties": [
    {
      "name": "Ivone Spencer",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Tony Ferreira",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-01-22T12:48:06-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good afternoon, Utilities billing, this is Tony. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:13-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yeah. I got a water bill."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:17-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, sure. What's going on with it?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:21-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It's not my name on it."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:25-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Gotcha. Whose name is on it, if you don't mind me asking?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:32-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "The man who sold me the house. Former owner."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:37-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, so you've just bought the place. Congratulations. When did you close on it?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:45-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Three weeks ago. About."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:48-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right. And what's the service address?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:52-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "222 Ruggles Avenue."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:48:54-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Two twenty-two Ruggles, up on the Hill. Okay. And your name?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:00-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Ivone Spencer."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:02-05:00",
      "duration": 3,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Ivone, is that I-V-O-N-E?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:05-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:07-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Great. Let me pull up the account. Bear with me a second."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:14-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Mm-hm."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:16-05:00",
      "duration": 21,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "[pause] Okay, I see it. The account is still under the previous owner's name. That happens a lot, the bill just keeps going out under the old name until the transfer gets done. Do you have the bill in front of you?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:37-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:39-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Can you read me the amount due at the bottom?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:45-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Four hundred eighteen dollars and sixty cents."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:49-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. And do you see a billing period listed on there, like from this date to this date?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:49:59-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "October to December."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:50:01-05:00",
      "duration": 18,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Right. So here's the thing. Part of that period was before you owned the house. The bill covers a few months of use, and you only had the place for the last piece of it."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:50:19-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "So why am I getting it?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:50:23-05:00",
      "duration": 28,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Fair question. The bill goes to whoever's on the account when it's generated. Nobody told us about the sale, so it went out in his name to the property. Normally that gets sorted out between the buyer and seller at the closing, with a final reading. Did you get anything at the closing about a water reading?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:50:51-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Don't know."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:50:53-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's okay. Your paperwork from the closing might say. Might be something the attorney's office handled, or a closing statement with a line for water and sewer."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:07-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I'll look."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:09-05:00",
      "duration": 17,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good. That would help us split it. In the meantime I can start the process of putting the account in your name. I'd need the date you took ownership. Do you have that?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:26-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "December thirtieth."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:28-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "December thirtieth. Okay. So honestly, most of that bill probably belongs to him, not you."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:36-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Then why is it on me?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:40-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Well, it's attached to the property, which is the tricky part. An unpaid balance can follow the house. So it's worth getting sorted rather than ignoring it."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:54-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That's ridiculous."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:51:56-05:00",
      "duration": 7,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I hear you. It's an annoying thing to inherit in the mailbox."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:03-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:05-05:00",
      "duration": 11,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "So what can I do for you today? Are you looking to get the name changed, or dispute the amount, or both?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:16-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Can I do a payment plan?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:20-05:00",
      "duration": 27,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, that's a good question. For the part that's yours, I'd think there may be something possible, but I don't know the details of how those are set up on a bill like this. I'd want to check with the billing supervisor, because it's tied to the old owner's account and that changes things."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:47-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Can you call me back?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:50-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Absolutely. I'll ask, and I'll call you with an answer. What's the best number?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:58-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "401-555-0179."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:52:59-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Four-oh-one, five-five-five, zero-one-seven-nine. Is that a cell?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:03-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:04-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay. Any time of day that's better?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:08-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Afternoon."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:09-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Afternoon, got it. I'll note it. I'm going to try to reach you today or tomorrow. If I get your voicemail I'll leave a message with my name."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:23-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Fine."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:24-05:00",
      "duration": 10,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Can I ask how you ended up calling us? Did you get a letter from us or something?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:34-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Man at the store said call."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:38-05:00",
      "duration": 13,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Ah, somebody at the store pointed you our way. Well, they steered you right. Sometimes it takes a neighbor or a clerk to say it."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:51-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Mm."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:53:52-05:00",
      "duration": 16,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "One more thing. If you can find that closing paperwork, anything that mentions water, sewer, or a final meter reading, have it handy when I call. That could speed this up."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:08-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:09-05:00",
      "duration": 15,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "And just so you know, I'm not asking you to pay anything right this minute. I'll put a note on the account that you called and that it's under review."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:24-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "All right."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:26-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Anything else I can help with while I have you?"
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:32-05:00",
      "duration": 1,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:33-05:00",
      "duration": 6,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, Ivone. I'll talk to you soon. Have a good afternoon."
    },
    {
      "type": "text",
      "start": "2026-01-22T12:54:39-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You too. Bye."
    }
  ],
