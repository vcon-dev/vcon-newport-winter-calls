  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Gina Mancini",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2026-01-05T11:00:30-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa. How can I help you?"
    },
    {
      "type": "text",
      "start": "2026-01-05T11:00:34-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Hi, yeah, um, I'm trying to reach the Naval base housing office? Is this, like, that?"
    },
    {
      "type": "text",
      "start": "2026-01-05T11:00:40-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, this is the City Clerk at Newport City Hall. The base housing office is a separate number, it's run through the Navy."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:00:48-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Oh, totally wrong place then. [line breaks up] Sorry, I'm working off this old list? Like, I think it's from three phone books ago."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:00:56-05:00",
      "duration": 8,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "That'll do it. I'd look up the base directly, or check the Navy's website for the housing office. They'll have the current line."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:01:04-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, yeah, I'll do that. [inaudible] Sorry, it's breaking up on my end."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:01:09-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No problem, I got you. Anything else I can help with today?"
    },
    {
      "type": "text",
      "start": "2026-01-05T11:01:14-05:00",
      "duration": 10,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, that's it. Honestly the thing I'm most looking forward to right now is the school holiday program next week? So I just need to get this sorted first."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:01:24-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Good luck with it. Have a good Monday."
    },
    {
      "type": "text",
      "start": "2026-01-05T11:01:28-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Thanks so much. Bye."
    }
  ],
