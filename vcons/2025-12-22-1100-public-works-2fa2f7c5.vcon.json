  "dialog": [
    {
      "type": "text",
      "start": "2025-12-22T11:00:28-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Public Works, this is Denise. Good morning."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:00:32-05:00",
      "duration": 9,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, good morning. My trash not picked up. Usual day is Monday, and today is Monday, but the truck not come yet."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:00:41-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, I can take that down. What's the address?"
    },
    {
      "type": "text",
      "start": "2025-12-22T11:00:45-05:00",
      "duration": 4,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "189 Broadway. One eight nine Broadway. North End."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:00:49-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Got it, 189 Broadway. Is the barrel out at the curb?"
    },
    {
      "type": "text",
      "start": "2025-12-22T11:00:54-05:00",
      "duration": 6,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, out since last night. I want a supervisor to call me back, please."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:00-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sure. A supervisor will call you this afternoon, probably around two o'clock."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:05-05:00",
      "duration": 2,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Sorry, ten o'clock? Ten?"
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:07-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, two. Two in the afternoon, after lunch."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:11-05:00",
      "duration": 5,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Okay, two o'clock. Two. Is it this number I call from?"
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:16-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I have it showing on my screen. Is it 401-555-0160?"
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:21-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, that is right. 0160. Thank you."
    },
    {
      "type": "text",
      "start": "2025-12-22T11:01:24-05:00",
      "duration": 4,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "You're welcome, Mr. Salazar. Have a good day."
    }
  ],
