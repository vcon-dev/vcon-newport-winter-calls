{
  "vcon": "0.4.0",
  "uuid": "4d30b5ad-18ce-8ffc-adaf-93b7ea04b517",
  "created_at": "2025-12-05T10:55:31-05:00",
  "subject": "Inbound call, City Clerk",
  "parties": [
    {
      "name": "Jose Rivera",
      "role": "resident",
      "validation": "synthetic"
    },
    {
      "name": "Rosa Delgado",
      "role": "clerk",
      "validation": "synthetic"
    }
  ],
  "dialog": [
    {
      "type": "text",
      "start": "2025-12-05T10:54:05-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "City Clerk's office, this is Rosa. Buenos días, how can I help you?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:54:10-05:00",
      "duration": 8,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, hello, I am looking for the housing office at the Naval base. The housing office. Is this that? I need the housing office, please."
    },
    {
      "type": "text",
      "start": "2025-12-05T10:54:18-05:00",
      "duration": 9,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, sir, this is the City Clerk at Newport City Hall. The base housing office is a separate place. You may have dialed the wrong number."
    },
    {
      "type": "text",
      "start": "2025-12-05T10:54:27-05:00",
      "duration": 12,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Wrong number? Oh. But I used the number I wrote down. The area code, is it not 401 for the base? I thought maybe it was a different one. Is it okay that I called here?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:54:39-05:00",
      "duration": 12,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "It's okay, no problem at all. Four-oh-one is right for Rhode Island, so the area code isn't the issue. Probably a digit got switched somewhere. Do you have the number written down in front of you?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:54:51-05:00",
      "duration": 11,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "I have it, yes, but my handwriting, it is not good. And my shift at the distribution center got moved again, so I wrote it down fast this morning. Is that okay, that I called you?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:55:02-05:00",
      "duration": 14,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Of course, señor. I can't connect you from here, but if you look up the Naval Station Newport housing office, you'll get the correct line. The base operator can also send you to them. Is there anything else I can help with here at City Hall?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:55:16-05:00",
      "duration": 7,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "No, no, just the housing office. I will look it up. So it is okay, I did not bother you?"
    },
    {
      "type": "text",
      "start": "2025-12-05T10:55:23-05:00",
      "duration": 5,
      "parties": [
        1
      ],
      "originator": 1,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Not at all. Stay safe out there today with the storm coming in."
    },
    {
      "type": "text",
      "start": "2025-12-05T10:55:28-05:00",
      "duration": 3,
      "parties": [
        0
      ],
      "originator": 0,
      "mediatype": "text/plain",
      "encoding": "none",
      "body": "Yes, thank you. Thank you very much. Goodbye."
    }
  ],
